generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  emailVerified    Boolean       @default(false)
  displayName      String?
  usernameChosen   Boolean       @default(true)   // false = we assigned a placeholder (Google sign-up)
  avatarUrl        String?
  passwordHash     String?
  resetTokenHash   String?
  resetTokenExp    DateTime?
  googleId         String?       @unique
  stripeCustomerId String?       @unique
  trialEnd         DateTime?
  alertEmail       Boolean       @default(true)
  alertThreshold   Int           @default(75)
  lastAlertAt      DateTime?
  emailOptOut      Boolean       @default(false)
  nurtureEmailAt   DateTime?                      // last free-member nudge email
  nurturePushLog   Json          @default("[]")   // recent free-member nudge pushes (timestamps)
  appLinkSentAt    DateTime?
  giftUntil        DateTime?                      // membership from a redeemed gift
  createdAt        DateTime      @default(now())
  sessions         Session[]
  subscription     Subscription?
  savedSpots       SavedSpot[]
  catches          Catch[]
  notes            Note[]
  posts            Post[]
  likes            Like[]
  comments         Comment[]
  blocking         Block[]       @relation("blocker")
  blockedBy        Block[]       @relation("blocked")
  pushSubs         PushSubscription[]
  notifications    Notification[]
  following        Follow[]      @relation("following")
  followers        Follow[]      @relation("followers")
  tripReports      TripReport[]
  tripIntents      TripIntent[]
  runCheckins      RunCheckin[]
}

model Event {
  id        String   @id @default(cuid())
  userId    String?
  type      String                        // view_reach | save | discover | radius | open_map | open_profile | …
  ref       String?                       // reach id when relevant
  meta      Json?
  visitorId String?                       // anonymous browser id (site + app share it)
  sessionId String?                       // one visit; a new one after 30 idle minutes
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([ref, createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId])
  @@index([userId, createdAt])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followedId String
  createdAt  DateTime @default(now())
  follower   User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("followers", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@index([followedId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String                        // recipient (post owner)
  type      String                        // "like" | "comment" | "follow"
  actorId   String
  actorName String   @default("An angler")
  postId    String?                        // null for follows
  preview   String   @default("")         // comment snippet
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Post {
  id        String    @id @default(cuid())
  userId    String
  body      String    @default("")
  photoUrl  String?
  photoW    Int?
  photoH    Int?
  river     String?
  category  String    @default("Report")
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Like[]
  comments  Comment[]

  @@index([createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Note {
  id        String    @id
  userId    String
  title     String    @default("")
  body      String    @default("")
  technique String    @default("")
  flies     String    @default("")
  species   String    @default("")
  size      String    @default("")
  lat       Float?
  lon       Float?
  ref       String?                       // nearest reach (client-computed) for intel
  createdAt DateTime
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([ref])
}

model Catch {
  id         String   @id @default(cuid())
  userId     String
  ref        String
  river      String
  section    String
  species    String
  sizeInches Float?
  technique  String?
  flies      String?
  caughtAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ref])
  @@index([userId])
}

model SavedSpot {
  id          String    @id @default(cuid())
  userId      String
  ref         String
  river       String
  section     String
  lat         Float
  lon         Float
  source      String    @default("verified")
  habitat     Json
  species     Json
  history     Int       @default(60)
  lastAlertAt DateTime?
  alertArmed  Boolean   @default(true)
  alertLog    Json      @default("[]")
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref])
}

model Subscription {
  id               String    @id
  userId           String    @unique
  status           String
  priceId          String?
  currentPeriodEnd DateTime?
  trialReminderFor DateTime?   // trial end we already sent a reminder for
  renewReminderFor DateTime?   // renewal date we already sent a reminder for
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Official Ontario Fishing Regulations Summary, one row per Fisheries
// Management Zone page on ontario.ca, refreshed by the regs sync.
model RegsZone {
  zone      Int      @id
  url       String
  hash      String                        // sha256 of the parsed content
  data      Json                          // parsed page (lib/regs-parse.js)
  fetchedAt DateTime                      // when this content was first seen
  checkedAt DateTime                      // last successful check (changed or not)
  lastError String?                       // last fetch/parse failure, cleared on success
  failedAt  DateTime?
}

// A detected change to an official zone page (what was added / removed).
model RegsChange {
  id         String   @id @default(cuid())
  zone       Int
  detectedAt DateTime @default(now())
  added      String[]
  removed    String[]

  @@index([detectedAt])
}

// Public blog at muddyyorkfishing.ca/blog, written in the admin dashboard.
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @default("")      // shown on the index and as the meta description
  body        String                      // Markdown (lib/markdown.js)
  coverUrl    String?                     // featured image
  coverAlt    String    @default("")
  status      String    @default("draft") // draft | published
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

// Last good answer from the public OpenStreetMap services (Overpass) per
// query, so scouting and parking still work when those servers are busy.
model MapDataCache {
  key       String   @id
  data      Json
  fetchedAt DateTime
}

// One angler's day on one river, blank days included. The ground truth the
// opportunity score is measured and later recalibrated against. Only the
// river (ref) is stored, never a location.
model TripReport {
  id          String   @id @default(cuid())
  userId      String
  ref         String
  river       String
  section     String   @default("")
  tripDate    DateTime              // the day fished (Toronto date, stored at noon UTC)
  fished      Boolean  @default(true)
  caught      Int      @default(0)
  species     Json     @default("[]")
  waterTempC  Float?
  note        String?
  scoreAtTrip Int?                  // the opportunity score we showed that morning
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref, tripDate])
  @@index([ref, tripDate])
}

// "Going fishing" signal (a Directions tap), so we can ask how it went the
// next morning. One per user, river and day.
model TripIntent {
  id         String    @id @default(cuid())
  userId     String
  ref        String
  river      String
  section    String    @default("")
  score      Int?
  dayKey     String                 // Toronto date, YYYY-MM-DD
  remindedAt DateTime?
  doneAt     DateTime?              // reported or dismissed
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref, dayKey])
  @@index([dayKey])
}

// Salmon and steelhead run sightings from members, per run spot.
model RunCheckin {
  id        String   @id @default(cuid())
  userId    String
  spot      String
  status    String                 // none | staging | moving | stacked | spawning | spent
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spot, createdAt])
}

// The weekly one-line run status we write for each run spot.
model RunNote {
  spot      String   @id
  note      String
  updatedAt DateTime @updatedAt
}

// A gift membership bought on the website. The code is emailed to the buyer
// (and the recipient, if given) and redeemed in the app.
model GiftCode {
  id             String    @id @default(cuid())
  code           String    @unique
  sessionId      String    @unique              // Stripe Checkout session
  paymentIntent  String?   @unique              // for matching refunds
  termsVersion   String?
  canceledAt     DateTime?                      // refunded: code no longer works
  buyerEmail     String
  recipientEmail String?
  recipientName  String?
  fromName       String?
  message        String?
  months         Int       @default(12)
  redeemedBy     String?
  redeemedAt     DateTime?
  createdAt      DateTime  @default(now())
}

// Small switches the admin can flip without a deploy (e.g. the ice season).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
